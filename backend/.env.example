# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/felicityDB

# Security
JWT_SECRET=your_jwt_secret_here

# Server Configuration
PORT=5050

# Email Service (Optional - for Nodemailer)
EMAIL_USER=user@example.com
EMAIL_PASS=password
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_FROM=no-reply@felicity.iiit.ac.in
